{
  "name": "zero-zone-desktop",
  "productName": "Zero Zone",
  "version": "0.1.0",
  "description": "لعبة منطقة الصفر - Zero Zone: لعبة بقاء وتصويب من منظور علوي داخل منطقة تتقلص",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": ["game", "electron", "shooter", "arabic"],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zerozone.desktop",
    "productName": "Zero Zone",
    "files": ["main.js", "src/**/*"],
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}
