{
  "name": "zero-zone-desktop",
  "productName": "Zero Zone",
  "version": "0.1.0",
  "description": "لعبة منطقة الصفر - Zero Zone: لعبة باتل رويال من منظور علوي ضد 49 خصماً على جزيرة تتقلص منطقتها الآمنة",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [
    "game",
    "electron",
    "battle-royale",
    "shooter",
    "arabic"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zerozone.desktop",
    "productName": "Zero Zone",
    "files": [
      "main.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
